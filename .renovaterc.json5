{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#10.0.1"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      description: "The Go toolchain is compiled into the binary, so its updates have to cut a release.",
      matchManagers: ["mise"],
      matchDepNames: ["go"],
      semanticCommitType: "fix",
    },
  ],
}
